# Backend environment variables. Copy to .env for local dev.
# These are read server-side only — never expose them to the frontend.

OPENAI_API_KEY=sk-...

# Models
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Retrieval relevance floor (cosine similarity). If the top match scores below
# this, we return the grounded "not found" fallback instead of answering.
SIMILARITY_THRESHOLD=0.35

# CORS: comma-separated allowed origins. Include your deployed frontend here.
# Example covers local dev and a Vercel domain:
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Database. Local dev defaults to SQLite; on Render set the Postgres URL, e.g.
# postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./ask_your_docs.db

# Auth. Generate a strong random JWT_SECRET in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=1440

# NOTE: On Render, $PORT is injected automatically and uvicorn binds to it
# (see Dockerfile) — you do not need to set PORT here.
