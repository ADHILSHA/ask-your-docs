# Frontend environment variables. Copy to .env.local for local dev.
# Only NEXT_PUBLIC_* vars reach the browser — never put secrets here.

# Local backend:
NEXT_PUBLIC_API_URL=http://localhost:8000

# In production (Vercel), set this to your deployed backend URL, e.g.:
# NEXT_PUBLIC_API_URL=https://ask-your-docs-backend.onrender.com
